# ==============================================================================
# DS-CONNECT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Local or Cloud Credentials
# For Cloud: Get from Supabase Project Settings -> API
# For Local: Defaults provided by 'npx supabase start'
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=mock-service-role-key

# PostgreSQL Direct Connection String (Used by FastAPI / SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres

# Redis Cache and Task Broker
REDIS_URL=redis://localhost:6379/0

# FastAPI Backend Settings
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-this-in-production-to-a-secure-random-64-character-hex-string

# Frontend Public Keys
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTI4MDB9.mock-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
